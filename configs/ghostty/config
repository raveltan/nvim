# Font
font-family = Zenbones Brainy
font-size = 18
font-thicken = false
adjust-cell-height = 4

# Shell
command = /opt/homebrew/bin/tmux new-session -A -s main

# Window transparency
# These were commented out, which made nvim's transparent moonfly theme pointless:
# it was drawing "transparent" onto an opaque black terminal.
# NOTE: the key is background-blur (integer, or true = 20). background-blur-radius
# is the OLD name and is silently ignored by Ghostty 1.3.x.
background-opacity = 0.83
background-blur = 5
# The real fix for the washed-out look at low opacity: a WCAG contrast floor, so
# moonfly's dim comment/hint greys survive a blurred wallpaper behind them.
# Lower this toward 1.0 if colors start looking punched-up.
minimum-contrast = 1.2
# Dim the unfocused split so the active pane is obvious (vim-tmux-navigator
# means several panes are usually open at once).
unfocused-split-opacity = 0.6
# Center the grid instead of pinning it top-left when the window isn't an exact
# multiple of the cell size.
window-padding-balance = true
macos-titlebar-style = hidden

background = 000000
foreground = edecee
cursor-color = a277ff
cursor-text = 15141b
selection-background = 3d375e
selection-foreground = edecee

# Normal colors (ANSI 0-7)
palette = 0=110f18
palette = 1=ff6767
palette = 2=61ffca
palette = 3=ffca85
palette = 4=5fa8ff
palette = 5=a277ff
palette = 6=61ffca
palette = 7=edecee

# Bright colors (ANSI 8-15)
palette = 8=6d6d6d
palette = 9=ff6767
palette = 10=61ffca
palette = 11=ffca85
palette = 12=8cc2ff
palette = 13=a277ff
palette = 14=61ffca
palette = 15=edecee

